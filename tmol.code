name = "ketua-nexus-quantum"
[durable_objects]
bindings = [{ name = "KETUA_NEXUS_BRAIN", class_name = "KetuaNexusBrain" }]
[kv_namespaces]
bindings = [{ binding = "HAK_PATEN_KV", id = "ketua-nexus-hak-paten" }]
[r2_buckets]
bindings = [{ binding = "FOTO_R2", bucket_name = "ketua-nexus-foto" }]
[[d1_databases]]
binding = "CHAT_D1"
database_name = "ketua-nexus-chat"
[ai]
binding = "AI"
[triggers]
crons = ["* * * * *"]
